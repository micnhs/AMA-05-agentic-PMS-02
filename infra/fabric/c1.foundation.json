{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "2.0.0.0",
  "parameters": {
    "name": { "type": "string", "minLength": 8, "maxLength": 20 },
    "location": { "type": "string", "allowedValues": ["francecentral"] },
    "tenantId": { "type": "string" },
    "tags": { "type": "object" },
    "capacityAdministrators": { "type": "array", "minLength": 1 },
    "network": { "type": "object" },
    "firewallPrivateIp": { "type": "string" },
    "compute": { "type": "object" }
  },
  "variables": {
    "dns": [
      "privatelink.fabric.microsoft.com",
      "privatelink.vaultcore.azure.net",
      "privatelink.azurecr.io",
      "privatelink.blob.core.windows.net",
      "privatelink.cognitiveservices.azure.com",
      "privatelink.openai.azure.com",
      "privatelink.services.ai.azure.com"
    ]
  },
  "resources": [
    {
      "type": "Microsoft.Network/routeTables", "apiVersion": "2024-05-01",
      "name": "[concat(parameters('name'), '-egress-routes')]", "location": "[parameters('location')]", "tags": "[parameters('tags')]",
      "properties": {
        "disableBgpRoutePropagation": false,
        "routes": [{
          "name": "ReviewedFirewallEgress",
          "properties": { "addressPrefix": "0.0.0.0/0", "nextHopType": "VirtualAppliance", "nextHopIpAddress": "[parameters('firewallPrivateIp')]" }
        }]
      }
    },
    {
      "type": "Microsoft.Fabric/capacities", "apiVersion": "2026-09-01-preview",
      "name": "[concat(parameters('name'), 'cap')]", "location": "[parameters('location')]",
      "tags": "[parameters('tags')]", "sku": { "name": "F2", "tier": "Fabric" },
      "properties": {
        "administration": { "members": "[parameters('capacityAdministrators')]" },
        "overage": { "state": "Disabled", "thresholdCapacityUnitHours": 0 }
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups", "apiVersion": "2024-05-01",
      "name": "[concat(parameters('name'), '-nsg')]", "location": "[parameters('location')]", "tags": "[parameters('tags')]",
      "properties": {
        "securityRules": [
          { "name": "DenyInbound", "properties": {
            "priority": 4000, "direction": "Inbound", "access": "Deny", "protocol": "*",
            "sourcePortRange": "*", "destinationPortRange": "*", "sourceAddressPrefix": "*", "destinationAddressPrefix": "*"
          }},
          { "name": "PrivateHttps", "properties": {
            "priority": 200, "direction": "Outbound", "access": "Allow", "protocol": "Tcp",
            "sourcePortRange": "*", "destinationPortRange": "443",
            "sourceAddressPrefix": "VirtualNetwork",
            "destinationAddressPrefixes": ["[parameters('network').endpointPrefix]", "[parameters('network').operatorAccess.operatorEndpointPrefix]"]
          }},
          { "name": "FirewallInspectedHttps", "properties": {
            "priority": 210, "direction": "Outbound", "access": "Allow", "protocol": "Tcp",
            "sourcePortRange": "*", "destinationPortRange": "443", "sourceAddressPrefix": "*", "destinationAddressPrefix": "Internet"
          }},
          { "name": "GuestAgentWireServer", "properties": {
            "priority": 220, "direction": "Outbound", "access": "Allow", "protocol": "Tcp",
            "sourcePortRange": "*", "destinationPortRanges": ["80", "32526"], "sourceAddressPrefix": "[parameters('network').clientPrefix]", "destinationAddressPrefix": "168.63.129.16"
          }},
          { "name": "FirewallDnsProxy", "properties": {
            "priority": 230, "direction": "Outbound", "access": "Allow", "protocol": "*",
            "sourcePortRange": "*", "destinationPortRange": "53", "sourceAddressPrefix": "*", "destinationAddressPrefix": "[parameters('firewallPrivateIp')]"
          }},
          { "name": "DenyOtherOutbound", "properties": {
            "priority": 4000, "direction": "Outbound", "access": "Deny", "protocol": "*",
            "sourcePortRange": "*", "destinationPortRange": "*", "sourceAddressPrefix": "*", "destinationAddressPrefix": "*"
          }}
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups", "apiVersion": "2024-05-01",
      "name": "[concat(parameters('name'), '-endpoint-nsg')]", "location": "[parameters('location')]", "tags": "[parameters('tags')]",
      "properties": {
        "securityRules": [
          { "name": "RuntimePrivateHttps", "properties": {
            "priority": 200, "direction": "Inbound", "access": "Allow", "protocol": "Tcp",
            "sourcePortRange": "*", "destinationPortRange": "443",
            "sourceAddressPrefixes": ["[parameters('network').clientPrefix]", "[parameters('network').agentPrefix]"], "destinationAddressPrefix": "*"
          }},
          { "name": "DenyOtherInbound", "properties": {
            "priority": 4000, "direction": "Inbound", "access": "Deny", "protocol": "*",
            "sourcePortRange": "*", "destinationPortRange": "*", "sourceAddressPrefix": "*", "destinationAddressPrefix": "*"
          }}
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups", "apiVersion": "2024-05-01",
      "name": "[concat(parameters('name'), '-operator-endpoint-nsg')]", "location": "[parameters('location')]", "tags": "[parameters('tags')]",
      "properties": {
        "securityRules": [
          { "name": "RuntimePrivateHttps", "properties": {
            "priority": 200, "direction": "Inbound", "access": "Allow", "protocol": "Tcp",
            "sourcePortRange": "*", "destinationPortRange": "443",
            "sourceAddressPrefixes": ["[parameters('network').clientPrefix]", "[parameters('network').agentPrefix]"], "destinationAddressPrefix": "*"
          }},
          { "name": "DelegatedBootstrapHttps", "properties": {
            "priority": 210, "direction": "Inbound", "access": "Allow", "protocol": "Tcp",
            "sourcePortRange": "*", "destinationPortRange": "443",
            "sourceAddressPrefix": "[parameters('network').operatorAccess.vpnClientPrefix]",
            "destinationAddressPrefix": "[parameters('network').operatorAccess.operatorEndpointPrefix]"
          }},
          { "name": "DenyOtherInbound", "properties": {
            "priority": 4000, "direction": "Inbound", "access": "Deny", "protocol": "*",
            "sourcePortRange": "*", "destinationPortRange": "*", "sourceAddressPrefix": "*", "destinationAddressPrefix": "*"
          }}
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks", "apiVersion": "2024-05-01",
      "name": "[concat(parameters('name'), '-vnet')]", "location": "[parameters('location')]", "tags": "[parameters('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', concat(parameters('name'), '-nsg'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', concat(parameters('name'), '-endpoint-nsg'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', concat(parameters('name'), '-operator-endpoint-nsg'))]",
        "[resourceId('Microsoft.Network/routeTables', concat(parameters('name'), '-egress-routes'))]"
      ],
      "properties": {
        "addressSpace": { "addressPrefixes": ["[parameters('network').vnetPrefix]"] },
        "dhcpOptions": { "dnsServers": ["[parameters('firewallPrivateIp')]"] },
        "subnets": [
          { "name": "GatewaySubnet", "properties": { "addressPrefix": "[parameters('network').operatorAccess.gatewayPrefix]" } },
          { "name": "AzureFirewallSubnet", "properties": { "addressPrefix": "[parameters('network').operatorAccess.firewallPrefix]" } },
          { "name": "client", "properties": {
            "addressPrefix": "[parameters('network').clientPrefix]", "defaultOutboundAccess": false,
            "routeTable": { "id": "[resourceId('Microsoft.Network/routeTables', concat(parameters('name'), '-egress-routes'))]" },
            "networkSecurityGroup": { "id": "[resourceId('Microsoft.Network/networkSecurityGroups', concat(parameters('name'), '-nsg'))]" }
          }},
          { "name": "agents", "properties": {
            "addressPrefix": "[parameters('network').agentPrefix]", "defaultOutboundAccess": false,
            "routeTable": { "id": "[resourceId('Microsoft.Network/routeTables', concat(parameters('name'), '-egress-routes'))]" },
            "networkSecurityGroup": { "id": "[resourceId('Microsoft.Network/networkSecurityGroups', concat(parameters('name'), '-nsg'))]" },
            "delegations": [{ "name": "foundry", "properties": { "serviceName": "Microsoft.App/environments" } }]
          }},
          { "name": "endpoints", "properties": {
            "addressPrefix": "[parameters('network').endpointPrefix]", "privateEndpointNetworkPolicies": "NetworkSecurityGroupEnabled",
            "networkSecurityGroup": { "id": "[resourceId('Microsoft.Network/networkSecurityGroups', concat(parameters('name'), '-endpoint-nsg'))]" }
          }},
          { "name": "operator-endpoints", "properties": {
            "addressPrefix": "[parameters('network').operatorAccess.operatorEndpointPrefix]", "privateEndpointNetworkPolicies": "NetworkSecurityGroupEnabled",
            "networkSecurityGroup": { "id": "[resourceId('Microsoft.Network/networkSecurityGroups', concat(parameters('name'), '-operator-endpoint-nsg'))]" }
          }}
        ]
      }
    },
    {
      "type": "Microsoft.Network/privateDnsZones", "apiVersion": "2020-06-01",
      "name": "[variables('dns')[copyIndex()]]", "location": "global", "tags": "[parameters('tags')]",
      "copy": { "name": "dnsZones", "count": "[length(variables('dns'))]" }, "properties": {}
    },
    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks", "apiVersion": "2020-06-01",
      "name": "[concat(variables('dns')[copyIndex()], '/', parameters('name'), '-link')]", "location": "global",
      "tags": "[parameters('tags')]",
      "copy": { "name": "dnsLinks", "count": "[length(variables('dns'))]" },
      "dependsOn": [
        "dnsZones",
        "[resourceId('Microsoft.Network/virtualNetworks', concat(parameters('name'), '-vnet'))]"
      ],
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": { "id": "[resourceId('Microsoft.Network/virtualNetworks', concat(parameters('name'), '-vnet'))]" }
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults", "apiVersion": "2024-11-01",
      "name": "[concat(parameters('name'), 'kv')]", "location": "[parameters('location')]", "tags": "[parameters('tags')]",
      "properties": {
        "tenantId": "[parameters('tenantId')]", "sku": { "family": "A", "name": "standard" },
        "enableRbacAuthorization": true, "enableSoftDelete": true, "enablePurgeProtection": true, "softDeleteRetentionInDays": 7,
        "publicNetworkAccess": "Disabled", "networkAcls": { "bypass": "None", "defaultAction": "Deny" }
      }
    },
    {
      "type": "Microsoft.ContainerRegistry/registries", "apiVersion": "2023-07-01",
      "name": "[concat(parameters('name'), 'acr')]", "location": "[parameters('location')]", "tags": "[parameters('tags')]",
      "sku": { "name": "Premium" },
      "properties": { "adminUserEnabled": false, "publicNetworkAccess": "Disabled", "networkRuleBypassOptions": "None" }
    },
    {
      "type": "Microsoft.Storage/storageAccounts", "apiVersion": "2023-05-01",
      "name": "[concat(parameters('name'), 'st')]", "location": "[parameters('location')]", "tags": "[parameters('tags')]",
      "sku": { "name": "Standard_LRS" }, "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false, "allowSharedKeyAccess": false, "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2", "publicNetworkAccess": "Disabled",
        "networkAcls": { "bypass": "None", "defaultAction": "Deny" }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers", "apiVersion": "2023-05-01",
      "name": "[concat(parameters('name'), 'st/default/c1-checkpoints')]",
      "dependsOn": ["[resourceId('Microsoft.Storage/storageAccounts', concat(parameters('name'), 'st'))]"],
      "properties": { "publicAccess": "None" }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers", "apiVersion": "2023-05-01",
      "name": "[concat(parameters('name'), 'st/default/c1-artifacts')]",
      "dependsOn": ["[resourceId('Microsoft.Storage/storageAccounts', concat(parameters('name'), 'st'))]"],
      "properties": { "publicAccess": "None" }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts", "apiVersion": "2026-07-15-preview",
      "name": "[concat(parameters('name'), '-ai')]", "location": "[parameters('location')]", "tags": "[parameters('tags')]",
      "kind": "AIServices", "sku": { "name": "S0" }, "identity": { "type": "SystemAssigned" },
      "dependsOn": ["[resourceId('Microsoft.Network/virtualNetworks', concat(parameters('name'), '-vnet'))]"],
      "properties": {
        "allowProjectManagement": true, "customSubDomainName": "[concat(parameters('name'), '-ai')]",
        "disableLocalAuth": true, "publicNetworkAccess": "Disabled", "a365LoggingEnabled": false,
        "networkAcls": { "bypass": "None", "defaultAction": "Deny" },
        "networkInjections": [{
          "scenario": "agent", "useMicrosoftManagedNetwork": false,
          "subnetArmId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', concat(parameters('name'), '-vnet'), 'agents')]"
        }]
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/projects", "apiVersion": "2026-07-15-preview",
      "name": "[concat(parameters('name'), '-ai/c1')]", "location": "[parameters('location')]", "tags": "[parameters('tags')]",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": ["[resourceId('Microsoft.CognitiveServices/accounts', concat(parameters('name'), '-ai'))]"],
      "properties": { "displayName": "Cohors Fabric C1", "description": "Isolated synthetic C1 only" }
    },
    {
      "type": "Microsoft.Network/networkInterfaces", "apiVersion": "2024-05-01",
      "name": "[concat(parameters('name'), '-nic')]", "location": "[parameters('location')]", "tags": "[parameters('tags')]",
      "dependsOn": ["[resourceId('Microsoft.Network/virtualNetworks', concat(parameters('name'), '-vnet'))]"],
      "properties": { "ipConfigurations": [{
        "name": "private",
        "properties": {
          "privateIPAllocationMethod": "Dynamic",
          "subnet": { "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', concat(parameters('name'), '-vnet'), 'client')]" }
        }
      }]}
    },
    {
      "type": "Microsoft.Compute/virtualMachines", "apiVersion": "2024-07-01",
      "name": "[concat(parameters('name'), '-probe')]", "location": "[parameters('location')]", "tags": "[parameters('tags')]",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": ["[resourceId('Microsoft.Network/networkInterfaces', concat(parameters('name'), '-nic'))]"],
      "properties": {
        "hardwareProfile": { "vmSize": "[parameters('compute').size]" },
        "osProfile": {
          "computerName": "cohors-c1", "adminUsername": "c1operator", "allowExtensionOperations": true,
          "linuxConfiguration": {
            "disablePasswordAuthentication": true, "provisionVMAgent": true,
            "ssh": { "publicKeys": [{ "path": "/home/c1operator/.ssh/authorized_keys", "keyData": "[parameters('compute').sshPublicKey]" }] }
          }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "[parameters('compute').imagePublisher]", "offer": "[parameters('compute').imageOffer]",
            "sku": "[parameters('compute').imageSku]", "version": "[parameters('compute').imageVersion]"
          },
          "osDisk": { "createOption": "FromImage", "osType": "Linux", "deleteOption": "Delete", "managedDisk": { "storageAccountType": "StandardSSD_LRS" } }
        },
        "networkProfile": { "networkInterfaces": [{ "id": "[resourceId('Microsoft.Network/networkInterfaces', concat(parameters('name'), '-nic'))]" }] }
      }
    }
  ],
  "outputs": {
    "vnet": { "type": "object", "value": "[reference(resourceId('Microsoft.Network/virtualNetworks', concat(parameters('name'), '-vnet')), '2024-05-01', 'Full')]" },
    "egressRoutes": { "type": "object", "value": "[reference(resourceId('Microsoft.Network/routeTables', concat(parameters('name'), '-egress-routes')), '2024-05-01', 'Full')]" },
    "capacity": { "type": "object", "value": "[reference(resourceId('Microsoft.Fabric/capacities', concat(parameters('name'), 'cap')), '2026-09-01-preview', 'Full')]" },
    "project": { "type": "object", "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts/projects', concat(parameters('name'), '-ai'), 'c1'), '2026-07-15-preview', 'Full')]" },
    "registry": { "type": "object", "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', concat(parameters('name'), 'acr')), '2023-07-01', 'Full')]" },
    "vault": { "type": "object", "value": "[reference(resourceId('Microsoft.KeyVault/vaults', concat(parameters('name'), 'kv')), '2024-11-01', 'Full')]" },
    "storage": { "type": "object", "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', concat(parameters('name'), 'st')), '2023-05-01', 'Full')]" },
    "checkpointContainer": { "type": "object", "value": "[reference(resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', concat(parameters('name'), 'st'), 'default', 'c1-checkpoints'), '2023-05-01', 'Full')]" },
    "artifactContainer": { "type": "object", "value": "[reference(resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', concat(parameters('name'), 'st'), 'default', 'c1-artifacts'), '2023-05-01', 'Full')]" },
    "probe": { "type": "object", "value": "[reference(resourceId('Microsoft.Compute/virtualMachines', concat(parameters('name'), '-probe')), '2024-07-01', 'Full')]" }
  }
}
