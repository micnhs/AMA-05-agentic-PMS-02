targetScope = 'subscription'

@description('Reviewed private start profile, including deterministic names, bounded sizes and no prebuilt resource IDs.')
param profile object
@description('App/group IDs generated by the journalled identities phase.')
param identities object
@description('Owned network and access outputs from the completed first stage.')
param networkPhase object
@description('Immutable ACR digest and boundary-review outputs generated by private publishing.')
param release object = {}
@description('Stage flag set only by the separately approved runtime plan.')
param deployRuntime bool = false
@description('Enable only after actual Operations telemetry ingestion/query readiness and notification review.')
param enableWatchdogAlert bool = false

var tags = {
  workload: 'cohors'
  environment: 'synthetic-pilot'
  dataClassification: 'synthetic'
  cohorsBinding: profile.bindingHash
  cohorsOwner: profile.deploymentId
  expiresAtUtc: profile.expiresAtUtc
}

resource workload 'Microsoft.Resources/resourceGroups@2024-03-01' existing = {
  name: profile.names.workloadResourceGroup
}

module platform 'main.bicep' = {
  name: '${profile.namePrefix}-platform'
  scope: workload
  params: {
    namePrefix: profile.namePrefix
    location: profile.location
    foundryLocation: profile.model.region
    createOwnedAccess: true
    networkResourceBindings: networkPhase.network
    sqlAdminGroupObjectId: identities.sqlAdmin.objectId
    sqlAdminGroupName: identities.sqlAdmin.displayName
    alertEmailReceivers: profile.alertEmailReceivers
    vnetPrefix: profile.network.vnet
    containerAppsSubnetPrefix: profile.network.containerApps
    workflowsSubnetPrefix: profile.network.workflows
    operationsSubnetPrefix: profile.network.operations
    privateEndpointsSubnetPrefix: profile.network.privateEndpoints
    egressSubnetPrefix: profile.network.egress
    operatorSubnetPrefix: profile.network.operator
    clientSubnetPrefix: profile.network.client
    bastionSubnetPrefix: profile.network.bastion
    nvaPrivateIp: profile.network.nvaPrivateIp
    sqlVcores: 2
    sqlMaxSizeGiB: 32
    sqlPitrDays: 14
    sqlBackupRedundancy: 'Local'
    sqlZoneRedundant: false
    storageSku: 'Standard_ZRS'
    searchSku: 'basic'
    searchReplicas: 1
    containerAppsZoneRedundant: false
    containerAppsWorkloadProfileType: profile.containerAppsProfile
    deployModel: profile.model.enabled
    modelName: profile.model.name
    modelVersion: profile.model.version
    modelDeploymentName: profile.model.deploymentName
    modelCapacity: profile.model.capacity
    deployRuntime: deployRuntime
    apiImageDigest: deployRuntime ? release.apiImageDigest : ''
    agentsImageDigest: deployRuntime ? release.agentsImageDigest : ''
    foundryBoundaryReview: deployRuntime ? release.boundaryReview : {}
    entraTenantId: profile.binding.tenantId
    apiAudience: identities.api.clientId
    agentsAudience: identities.agents.clientId
    spaClientId: identities.spa.clientId
    spaDelegatedScope: 'api://${identities.api.clientId}/access_as_user'
    workflowApiScope: 'api://${identities.api.clientId}/.default'
    agentsApiScope: 'api://${identities.agents.clientId}/.default'
    productGrants: profile.productGrants
    agentProducts: profile.products
    enableWatchdogAlert: enableWatchdogAlert
    enableDigestPublisherGrant: false
    tags: tags
  }
}

output platform object = {
  resources: platform.outputs.platformResourceIds
  identities: platform.outputs.workloadIdentities
  endpoints: platform.outputs.integrationEndpoints
  runtimeUrls: platform.outputs.runtimeUrls
  runtimeResources: platform.outputs.runtimeResources
  workloadName: platform.outputs.workloadName
  databaseName: platform.outputs.sqlDatabaseName
}
output access object = networkPhase.access
output ownedResourceGroups array = networkPhase.ownedResourceGroups
