{
  "version": "2.0",
  "functionTimeout": "00:10:00",
  "extensions": {
    "durableTask": {
      "hubName": "CohorsPilotV1",
      "tracing": { "traceInputsAndOutputs": false, "traceReplayEvents": false },
      "maxConcurrentActivityFunctions": 4,
      "maxConcurrentOrchestratorFunctions": 4
    }
  },
  "logging": {
    "logLevel": { "default": "Warning", "Host.Results": "Information" },
    "applicationInsights": {
      "samplingSettings": { "isEnabled": false },
      "enableDependencyTracking": false,
      "httpAutoCollectionOptions": { "enableHttpTriggerExtendedInfoCollection": false }
    }
  }
}
