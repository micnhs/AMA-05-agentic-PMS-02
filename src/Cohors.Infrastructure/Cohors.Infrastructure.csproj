<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Cohors.Application\Cohors.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Azure.Search.Documents" Version="12.0.0" />
    <EmbeddedResource Include="Migrations\*.sql" />
    <EmbeddedResource Include="..\..\fabric\c1\synthetic-source.json" LogicalName="Cohors.Fabric.C1.SyntheticSource.json" />
    <EmbeddedResource Include="..\..\infra\fabric\c1.hub-*.json" LogicalName="Cohors.Fabric.C1.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\infra\fabric\c1.foundation.json" LogicalName="Cohors.Fabric.C1.Foundation.json" />
    <EmbeddedResource Include="..\..\infra\fabric\c1.workspace-network.json" LogicalName="Cohors.Fabric.C1.WorkspaceNetwork.json" />
    <EmbeddedResource Include="..\..\contracts\regulatory-schemas\mir\incident-*.xsd" LogicalName="Cohors.Mir.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\contracts\terminology\fda-imdrf-2026.json" LogicalName="Cohors.Terminology.Fda2026.json" />
    <EmbeddedResource Include="..\..\contracts\domibus\5.2.2-jee10\*.*" LogicalName="Cohors.Domibus.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\contracts\eudamed\playground-3.0.36.1\**\*.xsd" LogicalName="Cohors.Eudamed/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\contracts\eudamed\playground-3.0.36.1\provenance.json" LogicalName="Cohors.Eudamed.Provenance.json" />
    <EmbeddedResource Include="..\..\contracts\eudamed\playground-3.0.36.1\enumerations\*.json" LogicalName="Cohors.Eudamed.Enum.%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
